{
  "name": "vorton-local",
  "version": "0.2.0-preview.36",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node scripts/demo.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "version:check": "node scripts/check-version.mjs",
    "check": "npm run version:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yazl": "3.3.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yazl": "3.3.1",
    "@types/yauzl": "3.4.0",
    "jspdf": "4.2.1",
    "modern-screenshot": "4.7.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
